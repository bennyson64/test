{
  "name": "@apps/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "run:android": "expo run:android",
    "dev1": "expo start",
    "dev": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "catalog:default",
    "@react-navigation/native": "catalog:default",
    "expo": "catalog:default",
    "expo-constants": "catalog:default",
    "expo-linking": "catalog:default",
    "expo-router": "catalog:default",
    "expo-status-bar": "catalog:default",
    "expo-system-ui": "catalog:default",
    "expo-web-browser": "catalog:default",
    "nativewind": "catalog:default",
    "openapi-fetch": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-native": "catalog:default",
    "react-native-gesture-handler": "catalog:default",
    "react-native-reanimated": "catalog:default",
    "react-native-safe-area-context": "catalog:default",
    "react-native-screens": "catalog:default",
    "react-native-web": "catalog:default",
    "react-native-worklets": "catalog:default"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "catalog:default",
    "@workspace/typescript-config": "workspace:*",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "catalog:default",
    "typescript": "catalog:default"
  },
  "private": true
